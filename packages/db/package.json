{
  "name": "@tma/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, connection factory and seed for the shop database",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts",
    "./testing": "./test/helpers.ts"
  },
  "scripts": {
