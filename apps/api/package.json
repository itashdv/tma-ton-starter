{
  "name": "@tma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API and payment worker entrypoints",
  "scripts": {
    "dev": "tsx watch --include \"../../config/**/*\" src/server.ts",
    "dev:worker": "tsx watch --include \"../../config/**/*\" src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@tma/db": "workspace:*",
    "@tma/shared": "workspace:*",
    "@ton/core": "0.63.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13"
  }
}
